# Godot
.godot/
*.translation
/export/
/exports/
export_presets.cfg
.mono/
data_*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local settings (never commit, never put in prompts)
.env
.env.*
*.key
*.pem
.claude/settings.local.json

# Harness run logs are local; keep the folder
harness/logs/*
!harness/logs/.gitkeep

# OS / editors
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Obsidian: machine-specific settings (the notes themselves are committed)
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.trash/

# Godot user data redirected into the project by some headless runs
/Godot/

# Run logs written by agent check scripts
art/build/*.log
art/build/arena_weapon_paths_motion/
art/build/arena_weapon_contact_pages/
art/build/arena_weapon_paths_*save.json*

# Obsidian (docs/ is the vault; settings are machine-specific, see docs/HARNESS.md)
docs/.obsidian/

# Graphify output (regenerate with: python -m graphify update .)
graphify-out/

# spare sound candidates (listening folder, not part of the game)
data/audio_candidates/
