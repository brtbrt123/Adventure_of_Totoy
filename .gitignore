# Godot
.godot/
*.translation
/export/
/exports/
export_presets.cfg
.mono/
data_*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local settings (never commit, never put in prompts)
.env
.env.*
*.key
*.pem
.claude/settings.local.json

# Harness run logs are local; keep the folder
harness/logs/*
!harness/logs/.gitkeep

# OS / editors
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Obsidian: machine-specific settings (the notes themselves are committed)
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.trash/
