{
 "generator": "tools/art/make_aspect_lantern_phantom_art.py (procedural, Pillow only, deterministic seeds)",
 "palette": "Totoy 36, hard alpha; no reserved gold x,y or red z,A",
 "scale": "1x game pixels (nearest-neighbour; preview sheets are scaled copies)",
 "status": "Reference art for the human's approval; not imported into art/src, not wired into the game",
 "aspect": "Phantom Cut (suggested display name: PHANTOM CUT; subtitle idea: 'THE BLADE REMEMBERS')",
 "request": "Totoy's NEXT basic attack spawns a delayed phantom copy of the same slash a moment later. Delay, damage, reach and cost are owner/core decisions.",
 "groups": {
  "fx_phantom_charge_<state>_<n>_<1..6>": "Same size and anchor as hero2_<state>_right_<n>; draw ON TOP of that hero frame while the next attack is charged. Six shimmer phases (loop at about 80 ms, independent of the hero frame): brightened blade with a cream glint running along it, lilac rim, motes. Made for idle 1-4 and walk 1-6; `charge_overlay()` makes the same for any katana frame (dash, parry, attack windup) from its blade pixels.",
  "fx_phantom_ghost_<swing>_<1..4>": "The phantom: hero2_attack<swing>_right_<3,4,4,5> recoloured (lilac outline, checkerboard body, bright blade). Same size/anchor as its source frame. 1 forming, 2 full (with speed streaks), 3 thinning, 4 fragments. Draw at Totoy's feet + ghost_offset_px along his facing, mirrored with him.",
  "fx_phantom_echo_<swing>_<1..4>": "96x64, anchor (40,56) = the phantom's feet. The echo slash: 1 swing 1 horizontal sweep, 2 reverse rising arc, 3 overhead to low. Phases lead/peak/follow/fragments. Draw over the phantom. Arcs reach about 34-37 px in front of the feet (katana reach is 34).",
  "fx_phantom_spark_<1..5>": "32x32, anchor (16,16) = where the echo hits (boss chest or the arc's midpoint). Pinch, star + ring, ring opens, broken ring + sparks, motes. Start it on echo phase 2.",
  "fx_phantom_mark_<1..4>": "16x16, anchor (8,15) = bottom centre; place 3 px above Totoy's head while Phantom Cut is armed (loop at about 120 ms). Small ghost katana, bobbing, glint running up."
 },
 "suggested_timeline": "cast: overlay + marker on. Next basic attack: marker and overlay off when the swing's active frame starts. About 150-200 ms after the real hit: ghost 1-4 with echo 1-4 (echo 2 = the phantom hit), spark 1-5 on the target.",
 "ghost_offset_px": 8,
